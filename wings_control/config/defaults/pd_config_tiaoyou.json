{
  "_comment": "PD 分离模型配置注册表。key = 模型架构 (model_architecture)，同时作为 external-lb PD 的门控白名单：取不到条目 = 未注册 = 不应用 PD external-lb（走原 standalone）。新增一个模型的 PD 支持 = 在此加一个架构条目，无需改 Python。各字段语义见 docs/xuqiu/deepseek-v32-pd-disaggregation.md §7.6。数值来源为 vllm-ascend 官方 tutorials，以官方文档为准（部分经摘要，落地前需逐项核对）。",
  "_schema": {
    "<ModelArchitecture>": {
      "connector": "KV 连接器名 (MooncakeLayerwiseConnector | MooncakeConnectorV1 | ...)",
      "kv_port": { "P": "producer 端口", "D": "consumer 端口" },
      "extra_config": "kv_connector_extra_config 的模型专属附加字段 (prefill/decode 全局拓扑由运行时按角色填入，不写这里)",
      "common": "P/D 共用的 engine 参数",
      "prefill": { "engine": "P 专属 engine 参数", "env": "P 专属环境变量" },
      "decode": { "engine": "D 专属 engine 参数", "env": "D 专属环境变量" }
    }
  },
  "pd_config": {
    "default": {
      "_comment": "未注册模型的 PD 分离兜底模板。仅含通用安全项；特定模型应单独注册条目覆盖。刻意不含 gpu_memory_utilization / enable_expert_parallel（非 MoE 会报错）/ max_num_* / 模型专属算子项。connector=MooncakeConnectorV1 时 engine_id 由运行时按 dp_rank 注入（见设计文档 §8-C2）。FULL_DECODE_ONLY 有 MTE 越界历史(R6)，新模型首次跑建议真机验证，必要时用专属条目覆盖为 enforce_eager。",
      "connector": "MooncakeConnectorV1",
      "kv_port": { "P": "30100", "D": "30400" },
      "extra_config": {},
      "common": { "trust_remote_code": true, "disable_hybrid_kv_cache_manager": true },
      "prefill": { "engine": { "enforce_eager": true }, "env": {} },
      "decode": {
        "engine": { "compilation_config": { "cudagraph_mode": "FULL_DECODE_ONLY" } },
        "env": { "TASK_QUEUE_ENABLE": "1" }
      }
    },
    "Qwen3MoeForCausalLM": {
      "_source": "用户自定义 3P1D launch_online_dp / run_dp_template.sh 对齐；Qwen3-30B-A3B。external-lb(DP fork)专用条目。",
      "_confirm": "落地前需真机确认的值：quantization(当前 platform 跑的是非量化 dtype=auto，故此处不设 ascend；若权重是 w8a8 再加 quantization=ascend)；disable_hybrid_kv_cache_manager=false(对齐模板 --no-disable，与 default 的 true 相反)；decode 的 max_num_batched_tokens/max_num_seqs 沿用模板 120/60，按真机吞吐再调；prefill/decode 的 HCCL 超时与 buffer 取自模板。",
      "connector": "MooncakeConnectorV1",
      "kv_port": { "P": "30000", "D": "30100" },
      "extra_config": {},
      "common": {
        "trust_remote_code": true,
        "enable_expert_parallel": true,
        "enable_prefix_caching": true,
        "disable_hybrid_kv_cache_manager": false
      },
      "prefill": {
        "engine": {
          "max_num_batched_tokens": 8192,
          "max_num_seqs": 4,
          "gpu_memory_utilization": 0.9,
          "enforce_eager": true,
          "additional_config": { "enable_cpu_binding": "True" }
        },
        "env": {
          "HCCL_INTRA_ROCE_ENABLE": "1",
          "USE_MULTI_GROUPS_KV_CACHE": "1",
          "USE_MULTI_BLOCK_POOL": "1",
          "ASCEND_BUFFER_POOL": "4:8",
          "HCCL_BUFFSIZE": "2560",
          "TASK_QUEUE_ENABLE": "1",
          "VLLM_RPC_TIMEOUT": "3600000",
          "VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS": "30000",
          "HCCL_EXEC_TIMEOUT": "204",
          "HCCL_CONNECT_TIMEOUT": "120"
        }
      },
      "decode": {
        "engine": {
          "max_num_batched_tokens": 120,
          "max_num_seqs": 60,
          "gpu_memory_utilization": 0.88,
          "async_scheduling": true,
          "compilation_config": { "cudagraph_mode": "FULL_DECODE_ONLY" }
        },
        "env": {
          "HCCL_INTRA_ROCE_ENABLE": "1",
          "VLLM_ASCEND_ENABLE_FUSED_MC2": "1",
          "USE_MULTI_GROUPS_KV_CACHE": "1",
          "USE_MULTI_BLOCK_POOL": "1",
          "ASCEND_BUFFER_POOL": "4:8",
          "HCCL_BUFFSIZE": "1024",
          "TASK_QUEUE_ENABLE": "1",
          "VLLM_RPC_TIMEOUT": "3600000",
          "VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS": "30000",
          "HCCL_EXEC_TIMEOUT": "2000",
          "HCCL_CONNECT_TIMEOUT": "1200"
        }
      }
    },
    "DeepseekV32ForCausalLM": {
      "_source": "https://docs.vllm.ai/projects/ascend/en/latest/tutorials/models/DeepSeek-V3.2.html",
      "connector": "MooncakeLayerwiseConnector",
      "kv_port": { "P": "30000", "D": "30100" },
      "extra_config": {},
      "common": {
        "enable_expert_parallel": true,
        "quantization": "ascend",
        "max_model_len": 68000,
        "no_enable_prefix_caching": true,
        "speculative_config": { "num_speculative_tokens": 2, "method": "deepseek_mtp" }
      },
      "prefill": {
        "engine": {
          "max_num_batched_tokens": 32560,
          "max_num_seqs": 64,
          "gpu_memory_utilization": 0.82,
          "enforce_eager": true,
          "additional_config": { "layer_sharding": ["q_b_proj", "o_proj"], "enable_dsa_cp": true }
        },
        "env": { "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1" }
      },
      "decode": {
        "engine": {
          "max_num_batched_tokens": 12,
          "max_num_seqs": 4,
          "gpu_memory_utilization": 0.95,
          "compilation_config": { "cudagraph_mode": "FULL_DECODE_ONLY", "cudagraph_capture_sizes": [3, 6, 9, 12] },
          "additional_config": { "recompute_scheduler_enable": true }
        },
        "env": { "TASK_QUEUE_ENABLE": "1" }
      }
    },
    "GlmMoeDsaForCausalLM": {
      "_source": "手工 GLM-5.1 P/D 启动命令注册表化复现（见 docs/reference/deploy-glm5.1-pd-vllm-serve-manual.md）。connector 用手工的 MooncakeConnectorV1（非官方 GLM5.2 的 kv_p2p MooncakeConnector）；无 platform_overrides，基条目即手工 910b 口径，两端 max_model_len=135168 同值。",
      "_caveats": "无法由 json 复现、由 .py/部署期 env 接管的项：engine_id 恒按 dp_rank（py 注入 __PD_RANK__→$RANK）；prefill/decode 的 dp·tp 来自部署期 env PD_PREFILL_DP_SIZE=4/PD_PREFILL_TP_SIZE=8/PD_DECODE_DP_SIZE=8/PD_DECODE_TP_SIZE=4；VLLM_ASCEND_BALANCE_SCHEDULING 被 _filter_pd_incompatible_env 无条件剔除（故刻意不写）；--data-parallel-rpc-port 角色硬编码 P=12890/D=12777；kv_port 在多 service/pod 时按 base+i 偏移。",
      "connector": "MooncakeConnectorV1",
      "connector_module_path": "vllm_ascend.distributed.mooncake_connector",
      "kv_port": { "P": "30000", "D": "30100" },
      "extra_config": { "use_ascend_direct": true },
      "common_env": {
        "HCCL_OP_EXPANSION_MODE": "AIV",
        "OMP_PROC_BIND": "false",
        "OMP_NUM_THREADS": "10",
        "VLLM_ASCEND_ENABLE_MLAPO": "1",
        "VLLM_ASCEND_ENABLE_NZ": "1",
        "HCCL_BUFFSIZE": "256",
        "PYTORCH_NPU_ALLOC_CONF": "expandable_segments:True",
        "TASK_QUEUE_ENABLE": "1",
        "CPU_AFFINITY_CONF": "1",
        "ASCEND_AGGREGATE_ENABLE": "1",
        "ASCEND_TRANSPORT_PRINT": "1",
        "ACL_OP_INIT_MODE": "1",
        "VLLM_NIXL_ABORT_REQUEST_TIMEOUT": "30000000",
        "HCCL_INTRA_ROCE_ENABLE": "1"
      },
      "common": {
        "enable_expert_parallel": true,
        "quantization": "ascend",
        "seed": 1024,
        "max_model_len": 135168,
        "async_scheduling": true,
        "enable_chunked_prefill": true,
        "enable_prefix_caching": true,
        "enable_auto_tool_choice": true,
        "tool_call_parser": "glm47",
        "reasoning_parser": "glm45",
        "speculative_config": { "num_speculative_tokens": 3, "method": "deepseek_mtp" }
      },
      "prefill": {
        "engine": {
          "max_num_batched_tokens": 4096,
          "max_num_seqs": 256,
          "gpu_memory_utilization": 0.95,
          "enforce_eager": true,
          "compilation_config": null,
          "additional_config": {
            "recompute_scheduler_enable": true,
            "multistream_overlap_shared_expert": true,
            "fuse_qknorm_rope": true,
            "fuse_muls_add": true,
            "enable_npugraph_ex": true
          }
        },
        "env": { "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1" }
      },
      "decode": {
        "engine": {
          "max_num_batched_tokens": 32,
          "max_num_seqs": 8,
          "gpu_memory_utilization": 0.95,
          "compilation_config": {
            "cudagraph_capture_sizes": [4, 8, 12, 16, 20, 24, 28, 32],
            "cudagraph_mode": "FULL_DECODE_ONLY"
          },
          "additional_config": {
            "recompute_scheduler_enable": true,
            "multistream_overlap_shared_expert": true,
            "fuse_qknorm_rope": true,
            "fuse_muls_add": true,
            "enable_npugraph_ex": true
          }
        },
        "env": {}
      }
    },
    "Qwen3_5MoeForConditionalGeneration": {
