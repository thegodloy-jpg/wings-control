# 910B dual-node HCCL env override template
#
# Usage:
# 1. Replace the placeholder IPs with the real hccn/RDMA IPs from each 910B node.
# 2. Mount this file into the wings-control container under:
#      /opt/wings-control/wings_control/config/env_overrides/910b_hccl.env
# 3. Restart both pods so /shared-volume/start_command.sh is regenerated.
#
# Format:
#   HCCL_DEVICE_IPS=node0_card0,node0_card1,...;node1_card0,node1_card1,...
#
# Single-card dual-node example:
#   HCCL_DEVICE_IPS=192.168.100.10;192.168.101.10
#
# Two-node x 8-card example:
#   HCCL_DEVICE_IPS=192.168.100.10,192.168.100.11,192.168.100.12,192.168.100.13,192.168.100.14,192.168.100.15,192.168.100.16,192.168.100.17;192.168.101.10,192.168.101.11,192.168.101.12,192.168.101.13,192.168.101.14,192.168.101.15,192.168.101.16,192.168.101.17
#
# Keep this file identical on both nodes. The generated start script uses RANK
# to pick the current node group when deriving HCCL_IF_IP.

HCCL_DEVICE_IPS=node0_card0_hccn_ip;node1_card0_hccn_ip

# 910B MindIE/ATB compatibility values. Most of these are now built into
# mindie_distributed_env.sh as fallback defaults; keep them here for explicit
# site-level override and for documenting the 910B manual launch baseline.
ATB_WORKSPACE_MEM_ALLOC_ALG_TYPE=3
ATB_WORKSPACE_MEM_ALLOC_GLOBAL=1
TASK_QUEUE_ENABLE=2
CPU_AFFINITY_CONF=1
ATB_LAYER_INTERNAL_TENSOR_REUSE=1
ATB_OPERATION_EXECUTE_ASYNC=1
ATB_CONVERT_NCHW_TO_ND=1
ATB_CONTEXT_WORKSPACE_SIZE=0
ATB_LAUNCH_KERNEL_WITH_TILING=1
ATB_LLM_ENABLE_AUTO_TRANSPOSE=0
ATB_LLM_LCOC_ENABLE=0

# Match the manual 910B baseline if needed. The project default remains 600;
# setting this env override preserves 0 because the generated script uses
# HCCL_EXEC_TIMEOUT="${HCCL_EXEC_TIMEOUT:-600}".
HCCL_EXEC_TIMEOUT=0

# Do not set NPU_MEMORY_FRACTION here if you want it to override the project
# default. set_mindie_env.sh runs later and exports NPU_MEMORY_FRACTION=0.96.
# To intentionally use 0.9, set GPU_MEMORY_UTILIZATION=0.9 in the sidecar/CLI
# so it becomes engine_config.npu_memory_fraction after config loading.
# NPU_MEMORY_FRACTION=0.9

# Optional: only set HCCL_SOCKET_IFNAME if the 910B environment requires a
# specific interface. Leaving it unset keeps the default eth0 fallback.
# HCCL_SOCKET_IFNAME=hccn0
# GLOO_SOCKET_IFNAME=eth0

# Optional: enable detailed Ascend/HCCL logs for one diagnostic run.
# ASCEND_GLOBAL_LOG_LEVEL=3
# ASCEND_SLOG_PRINT_TO_STDOUT=1
